{
  "scheduler": {
    "startTime": "08:00",
    "endTime": "23:30",
    "intervalMinutes": 15
  },
  "command": {
    "executable": "agy",
    "args": [
      "--log-file",
      "nul",
      "--prompt",
      "hi"
    ],
    "maxRetries": 3
  },
  "monitor": {
    "intervalMinutes": 30,
    "agyTimeoutMs": 30000
  },
  "web": {
    "port": 6789,
    "host": "0.0.0.0",
    "trayEnabled": true
  },
  "imageGen": {
    "enabled": true,
    "endpoint": "",
    "method": "GenerateImage",
    "model": "gemini-3.1-flash-image",
    "prompt": "a tiny red square on white background",
    "authToken": "",
    "timeoutMs": 30000
  }
}